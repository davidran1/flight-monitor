# ==============================================================
# הגדרות חיפוש טיסות
# ==============================================================
ORIGIN=TLV
DESTINATION=HKT
AIRLINE_CODE=EY
MAX_DURATION_HOURS=15.0

# טווח שהות בפוקט (בימים)
MIN_STAY_DAYS=15
MAX_STAY_DAYS=25

# חודשים לסריקה (1=ינואר, 2=פברואר) ושנה מבוקשת
TARGET_MONTHS=1,2
TARGET_YEAR=2027

# דילוג בימים לצורך אופטימיזציה
DEPARTURE_STEP_DAYS=2
STAY_STEP_DAYS=3

# ==============================================================
# הגדרות שליחת מייל התראות (SMTP של Gmail או כל ספק אחר)
# ==============================================================
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# סיסמת יישום של גוגל (16 תווים - Google App Password):
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# כתובת המייל שאליה תרצה לקבל את ההתראות:
EMAIL_TO=your_email@gmail.com

# ==============================================================
# ניטור רציף
# ==============================================================
SCAN_INTERVAL_MINUTES=60
